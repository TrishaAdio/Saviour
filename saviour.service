# Keeps Saviour running: restarts it after a crash and starts it on boot.
#
#   cp saviour.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now saviour
#
# Logs:   journalctl -u saviour -f     (saviour.log is written as well)
# Status: systemctl status saviour
#
# Run `python3 setup.py` first: the login needs your phone and code once.
# Adjust the paths below if Saviour doesn't live in /root/Saviour.
[Unit]
Description=Saviour redirect userbot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/root/Saviour
ExecStart=/root/Saviour/venv/bin/python3 /root/Saviour/saviour.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
