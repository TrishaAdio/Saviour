# --- required (setup.py fills these in for you) ----------------------------
# From https://my.telegram.org/apps → API development tools
API_ID=
API_HASH=
# Your own account's numeric id (@userinfobot tells you).
# Must be a DIFFERENT account from the one running the bot.
OWNER_ID=

# --- optional --------------------------------------------------------------
# POST_SLOTS=5           # link lines in the redirect post
# POST_TITLE=none        # bold line above the links; none = no title
# CHECK_EVERY=300        # seconds between health rounds
# SYNC_EVERY=900         # seconds between searches for channels to adopt
# GAP=3                  # seconds between two channels in one round
# MAX_WAIT=300           # longest flood-wait to sit out
# STRIKES=3              # failed rounds in a row before a channel is parked
# REPOST_IF_DELETED=true
# SESSION_NAME=saviour
